# Ghostline — environment template. Copy to .env and fill in. Do NOT put real secrets here.
# CALL-E API key from https://dashboard.heycall-e.com/account/api-keys
CALLE_API_KEY=iams_live_xxxxxxxxxxxxxxxx

# LLM for the extractor + pack generator (set ONE).
# Free tier, no card: https://aistudio.google.com/apikey  (key is prefixed AQ. or AIza)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash        # default; use gemini-flash-lite-latest if quota is tight
# Anthropic (paid) alternative:
LLM_API_KEY=

# Your own test phone line(s) in E.164 (comma-separated), used for dev/demo calls
GHOSTLINE_TEST_NUMBERS=+10000000000

# Below this many remaining CALL-E calls, live calling is disabled and the app falls back to replay
GHOSTLINE_CREDIT_FLOOR=10

# "replay" (default, no live calls) or "live"
GHOSTLINE_MODE=replay

# Live "call yourself" on a serverless host (Vercel) also needs these — set them here AND in
# the Vercel project's Environment Variables (Production + Preview):
# GHOSTLINE_WEBHOOK_BASE=https://<your-app>.vercel.app
# CALLE_WEBHOOK_SECRET=<from the CALL-E dashboard webhook settings>   # optional hardening
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io                      (free, no card: console.upstash.com)
# UPSTASH_REDIS_REST_TOKEN=
